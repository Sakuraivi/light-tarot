{
  "name": "light-tarot-web",
  "main": "./cloudflare/web.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "TAROT_API", "service": "light-tarot" }]
}
